{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jira-governance-email-worker",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "triggers": {
    "crons": [
      "15 3 * * *",
      "30 3 * * 1"
    ]
  },
  "vars": {
    "TIMEZONE": "Asia/Kolkata",
    "ALLOWED_ORIGIN": "*",
    "JIRA_FIELDS": "summary,status,assignee,priority,created,updated,resolutiondate,issuetype,components,parent,issuelinks,duedate,timetracking"
  }
}
